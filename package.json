{
    "name": "mimicm3u8downloader",
    "version": "0.1.4",
    "description": "m3u8 downloader with browser tls fingerprint",
    "type": "module",
    "private": "true",
    "scripts": {
        "server": "node src/bin/server.ts",
        "build": "node build.ts",
        "check": "npm run typecheck && npm run lint && npm run format:check",
        "format": "prettier --write .",
        "test": "npm run test:hls --",
        "test:hls": "node --experimental-test-module-mocks tests/local-hls.mjs verify",
        "test:hls:5min": "npm run test:hls -- --seconds 300 --variant aes-fmp4 --samples 2",
        "test:hls:resume": "npm run test:hls:worker -- --mode fmp4 --scenario resume --variant aes-fmp4",
        "test:hls:serve:cached": "npm run test:hls:serve -- --fixtures disk",
        "test:hls:build": "node tests/local-hls.mjs build",
        "test:hls:serve": "node tests/local-hls.mjs serve",
        "test:hls:worker": "node tests/local-hls.mjs verify --engine worker --video disk",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "knip": "knip",
        "registerUrlProtocol": "node src/bin/protocol.ts --register",
        "unregisterUrlProtocol": "node src/bin/protocol.ts --unregister"
    },
    "author": "DreamNya",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DreamNya/MimicM3U8Downloader.git"
    },
    "license": "MIT",
    "imports": {
        "#package": "./package.json",
        "#src/*": "./src/*",
        "#config/*": "./config/*"
    },
    "dependencies": {
        "impit": "^0.14.9",
        "p-limit": "^7.3.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.2",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "eslint": "^8.54.0",
        "knip": "^6.26.0",
        "typescript": "^5.9.3"
    },
    "keywords": [
        "m3u8",
        "downloader",
        "tls-fingerprint",
        "cloudflare-bypass",
        "ffmpeg",
        "impit"
    ]
}
